# ---------- Job (jobs/) ----------
# Token de serviço do Pipefy com leitura no pipe 302370343 e nas databases 301811379 e 304272431
PIPEFY_TOKEN=

# Postgres na Neon (projeto square-paper-93509555). `npx neon@latest env pull` preenche os dois.
# DATABASE_URL usa o pooler (app e job); DATABASE_URL_UNPOOLED é a conexão direta, usada nas migrações.
# Sem Neon: `docker compose up -d` sobe um Postgres local na porta 5433; use a mesma URL nas duas.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# URL pública do painel, usada nos links dos e-mails (ex.: https://prazos.grupobrmed.com.br)
PAINEL_URL=http://localhost:3000

# Remetente dos e-mails (domínio verificado no Mandrill)
REMETENTE_EMAIL=noreply@grupobrmed.com.br
REMETENTE_NOME=Briefing Suporte
# JSON da conta de serviço (conteúdo inteiro, numa linha) com delegação para o escopo gmail.send
GOOGLE_SERVICE_ACCOUNT_JSON=
# Caixas (separadas por vírgula) que recebem alerta quando o job falha e a lista de gestores sem e-mail;
# os e-mails de ENVIO=teste vão só para a primeira
ALERTA_EMAIL=
# Envio dos e-mails: desligado (padrão) | teste (tudo para ALERTA_EMAIL) | gestores
ENVIO=desligado

# ---------- Painel (Next + Auth.js) ----------
# gere com: openssl rand -base64 33
AUTH_SECRET=
# só fora da Vercel (next start, Docker); a Vercel já é confiável
AUTH_TRUST_HOST=true
# OAuth client do tipo Interno no Google Cloud. Redirecionamento: <url do painel>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# e-mails (separados por vírgula) que abrem o painel na visão de todos; os demais gestores abrem na própria carteira
GESTAO_EMAILS=

# ---------- Disparo diário pela Vercel (vercel.json → /api/cron/briefing) ----------
# A Vercel manda "Authorization: Bearer <CRON_SECRET>"; gere com: openssl rand -hex 32
CRON_SECRET=
# Token do GitHub (fine-grained) só para QualidadeGestaoBRMED/newsletter, permissão Actions: Read and write
# O token atual da Vercel foi gerado em 2026-10-27 com validade de 1 ano: renovar antes de 2027-10-27
GITHUB_DISPATCH_TOKEN=
